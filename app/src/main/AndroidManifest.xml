<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privileged Permission required to modify system developer flags via ADB grant -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Runtime Permission for persistent notification on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        SECURITY NOTICE:
        The following permissions are DELIBERATELY EXCLUDED:
        - android.permission.INTERNET (Offline only; impossible to exfiltrate data)
        - android.permission.ACCESS_NETWORK_STATE
        - android.permission.RECEIVE_BOOT_COMPLETED (Removed: automatic boot restore is not guaranteed on OxygenOS; manual recovery is enforced)
        - android.permission.PACKAGE_USAGE_STATS (No background spying/monitoring)
        - android.permission.FOREGROUND_SERVICE (No permanent daemon processes)
        - Accessibility Service (No tapjacking or accessibility disruption)
    -->

    <!-- Queries launcher apps for target banking app picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DevShieldApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevShield">

        <!-- Main User Interface Activity (Exported for Launcher) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non-exported receiver for notification Restore action (Strictly private) -->
        <receiver
            android:name=".receiver.RestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.devshield.action.RESTORE_SETTINGS" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile Service (Protected by BIND_QUICK_SETTINGS_TILE) -->
        <service
            android:name=".service.DevShieldTileService"
            android:icon="@drawable/ic_shield"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
